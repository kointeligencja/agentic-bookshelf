{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/search.js": {
      "includeFiles": "api/catalog.json"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ]
}
